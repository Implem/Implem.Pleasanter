{
    "name": "wwwroot",
    "private": true,
    "version": "1.5.9",
    "type": "commonjs",
    "scripts": {
        "dev": "concurrently \"npm:watch:scripts:app\" \"npm:watch:scripts:modules\" \"npm:watch:styles\" \"npm:watch:themes\" \"npm:watch:reload\"",
        "watch:themes": "node dev/theme.watch.copy.mjs",
        "watch:scripts:app": "vite build --config dev/vite.config.app.ts --watch --mode development",
        "watch:scripts:modules": "vite build --config dev/vite.config.modules.ts --watch --mode development",
        "watch:styles": "node dev/sass.watch.styles.mjs",
        "watch:reload": "node dev/browsersync.mjs",
        "build": "concurrently --kill-others-on-fail \"tsc\" \"vite build\" && vite build --config vite.config.app.ts",
        "clean": "rimraf node_modules",
        "typecheck": "tsc",
        "test": "vitest run --project unit",
        "test:watch": "vitest --project unit",
        "test:browser": "playwright install chromium && vitest run --project browser"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@fullcalendar/core": "6.1.21",
        "@types/glidejs__glide": "^3.6.6",
        "@types/jquery": "^3.5.34",
        "@types/jqueryui": "^1.12.24",
        "@types/node": "^24.13.3",
        "@vitest/browser-playwright": "^5.0.3",
        "@vitest/coverage-v8": "^5.0.3",
        "browser-sync": "^3.0.4",
        "concurrently": "^10.0.5",
        "eslint": "^10.11.0",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.13.0",
        "happy-dom": "^20.14.5",
        "playwright": "^1.63.0",
        "prettier": "^3.9.9",
        "prettier-plugin-embed": "^0.5.1",
        "rimraf": "^6.1.3",
        "sass": "^1.105.1",
        "sass-embedded": "^1.105.1",
        "stylelint": "^17.16.0",
        "stylelint-config-recess-order": "^7.8.0",
        "stylelint-config-recommended-scss": "^17.0.1",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
        "stylelint-order": "^8.1.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.3.2",
        "vite-plugin-static-copy": "^4.1.1",
        "vitest": "^5.0.3"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.20.3",
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lang-css": "^6.3.1",
        "@codemirror/lang-html": "^6.4.12",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/language": "^6.12.4",
        "@codemirror/state": "^6.7.6",
        "@codemirror/theme-one-dark": "^6.1.3",
        "@codemirror/view": "^6.43.13",
        "@glidejs/glide": "^3.7.1",
        "codemirror": "6.0.2",
        "diff": "^9.0.0",
        "dompurify": "^3.4.16",
        "flatpickr": "^4.6.13",
        "highlight.js": "^11.12.0",
        "jquery": "3.7.1",
        "marked": "^18.0.14",
        "moment": "^2.31.0",
        "suneditor": "^3.3.3"
    },
    "overrides": {
        "shell-quote": "^1.9.0"
    },
    "volta": {
        "node": "24.18.0",
        "npm": "11.6.4"
    }
}
